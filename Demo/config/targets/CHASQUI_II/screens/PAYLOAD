        END

        VERTICALBOX "System Storage"
          SETTING BACKCOLOR 248 250 252
          SETTING BORDERCOLOR 200 210 220

          SPACER 0 6
          LABEL "STORAGE CONFIGURATION"
            SETTING TEXTCOLOR 46 204 113
            SETTING FONT "bold"
            SETTING FONTSIZE 10
          SPACER 0 6

          HORIZONTAL 8
            LABEL "Current SD:"
              SETTING TEXTCOLOR 60 60 60
              SETTING WIDTH 95
            SPACER 6 0
            VALUE CHASQUI_II Beacon Current_SD CONVERTED 14
              SETTING WIDTH 120
              SETTING HEIGHT 16
              SETTING BACKCOLOR 235 235 235
              SETTING BORDERCOLOR 190 190 190
              SETTING TEXTCOLOR 46 204 113
              SETTING FONT "bold"
              SETTING FONTSIZE 11
