###############################################################################
# CHASQUI_II Telemetry Screen - PAYLOAD SYSTEM DASHBOARD (COMPACTO)
###############################################################################

SCREEN AUTO AUTO 0.5
GLOBAL_SETTING LABELVALUELIMITSBAR COLORBLIND TRUE

SCROLLWINDOW
  VERTICAL 6
    SETTING BACKCOLOR 240 242 245
    SETTING TEXTCOLOR 30 30 30

    ###########################################################################
    # HEADER
    ###########################################################################
    HORIZONTALBOX
      SETTING BACKCOLOR 15 76 129
      SETTING BORDERCOLOR 10 50 90

      HORIZONTAL 12
        CANVAS 56 56
          CANVASIMAGE "logo-chasqui.jpg" 0 0
        END

        VERTICAL 2 FALSE
          TITLE "PAYLOAD SYSTEM CONTROL"
            SETTING TEXTCOLOR 255 255 255
            SETTING BACKCOLOR 15 76 129
            SETTING FONTSIZE 16
          LABEL "Scientific Payload Telemetry & Monitoring"
            SETTING TEXTCOLOR 180 200 220
            SETTING BACKCOLOR 15 76 129
        END

        SPACER 20 0 EXPANDING MINIMUM

        VERTICAL 2 FALSE
          SPACER 0 6
          HORIZONTAL 8
            LABEL "Payload Mode:"
              SETTING TEXTCOLOR 255 255 255
              SETTING BACKCOLOR 15 76 129
            VALUE CHASQUI_II Beacon Sat_Curr_Mode CONVERTED 14
              SETTING TEXTCOLOR 255 255 255
              SETTING FONT "bold"
              SETTING WIDTH 120
              SETTING HEIGHT 18
              SETTING BACKCOLOR 15 76 129
              SETTING BORDERCOLOR 15 76 129
          END
          SPACER 0 6
        END
      END
    END

    SPACER 0 6

    ###########################################################################
    # PAYLOAD OVERVIEW (FRANJA AZUL)
    ###########################################################################
    LABEL "  PAYLOAD OVERVIEW"
      SETTING BACKCOLOR 15 76 129
      SETTING TEXTCOLOR 255 255 255
      SETTING FONT "bold"
      SETTING FONTSIZE 12
    SPACER 0 6

    ###########################################################################
    # ROW 1: OVERVIEW CONTENT
    ###########################################################################
    HORIZONTALBOX
      SETTING BACKCOLOR 255 255 255
      SETTING BORDERCOLOR 200 210 220
      SETTING HEIGHT 235

      MATRIXBYCOLUMNS 2 10 8

        #######################################################################
        # Power Parameters (compacto)
        #######################################################################
        VERTICALBOX "Power Parameters"
          SETTING BACKCOLOR 248 250 252
          SETTING BORDERCOLOR 200 210 220
          SETTING WIDTH 330

          SPACER 0 6
          LABEL "POWER SUPPLY STATUS"
            SETTING TEXTCOLOR 46 204 113
            SETTING FONT "bold"
            SETTING ALIGNCENTER
            SETTING FONTSIZE 11
          SPACER 0 8

          HORIZONTAL 8
            LIMITSCOLOR CHASQUI_II Beacon PL_12v_Volt CONVERTED 10 NIL
            LABEL "Power Health"
              SETTING TEXTCOLOR 100 100 100
          END

          SPACER 0 8

          LABELVALUELIMITSBAR CHASQUI_II Beacon PL_12v_Volt CONVERTED 13
            SETTING WIDTH 300
            SUBSETTING 0 TEXTCOLOR 80 80 80
          SPACER 0 6

          LABELVALUELIMITSBAR CHASQUI_II Beacon PL_12v_Curr CONVERTED 13
            SETTING WIDTH 300
            SUBSETTING 0 TEXTCOLOR 80 80 80
          SPACER 0 8

          HORIZONTAL 8
            LABEL "Power Status:"
              SETTING TEXTCOLOR 60 60 60
              SETTING WIDTH 115
            SPACER 6 0
            VALUE CHASQUI_II Beacon Sat_Curr_Mode CONVERTED 14
              SETTING WIDTH 110
              SETTING HEIGHT 18
              SETTING BACKCOLOR 235 235 235
              SETTING BORDERCOLOR 190 190 190
              SETTING TEXTCOLOR 0 0 0
              SETTING FONT "bold"
              SETTING FONTSIZE 11
          END

          SPACER 0 8

          LABELVALUELIMITSBAR CHASQUI_II Beacon Main_Batt_Volt CONVERTED 13
            SETTING WIDTH 300
            SUBSETTING 0 TEXTCOLOR 80 80 80

          SPACER 0 6
        END

        #######################################################################
        # Command History (compacto)
        #######################################################################
        VERTICALBOX "Command History"
          SETTING BACKCOLOR 248 250 252
          SETTING BORDERCOLOR 200 210 220

          SPACER 0 6
          LABEL "COMMAND ACCEPTANCE HISTORY"
            SETTING TEXTCOLOR 46 204 113
            SETTING FONT "bold"
            SETTING FONTSIZE 11
          SPACER 0 6

          LINEGRAPH CHASQUI_II Beacon Command_Accept_Counter 520 1100 150 CONVERTED
            SETTING BACKCOLOR 255 255 255
            SETTING BORDERCOLOR 200 210 220
            SETTING POINTSIZE 5

          SPACER 0 6

          HORIZONTAL 10
            LABEL "Monitoring:"
              SETTING TEXTCOLOR 120 120 120
              SETTING FONTSIZE 10
            SPACER 0 0 EXPANDING MINIMUM
            LABEL "ACTIVE"
              SETTING TEXTCOLOR 46 204 113
              SETTING FONT "bold"
              SETTING FONTSIZE 10
          END

          SPACER 0 6
        END

      END
    END

    SPACER 0 8

