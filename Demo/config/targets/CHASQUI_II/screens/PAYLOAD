              SETTING TEXTCOLOR 46 204 113
              SETTING FONT "bold"
              SETTING FONTSIZE 11
          END

          SPACER 0 4

          HORIZONTAL 8
            LABEL "Boot Cnt:"
              SETTING TEXTCOLOR 60 60 60
              SETTING WIDTH 95
            SPACER 6 0
            VALUE CHASQUI_II Beacon Boot_Counter CONVERTED 14
              SETTING WIDTH 120
